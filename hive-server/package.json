{
  "name": "hive-server",
  "version": "1.0.0",
  "private": true,
  "description": "Chart Hive data server for SOVA /charts (HTTP + /stream websocket). Deployed separately from the Next app.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch-path=server server/index.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "jose": "6.2.3",
    "protobufjs": "8.8.1",
    "ws": "8.22.1"
  }
}
