# hive-server settings. Locally, copy to hive-server/.env.local (never committed, never in the Docker image).
# On Fly.io set the secrets with `fly secrets set`, and the plain values in fly.toml [env].

# Must equal SOVA's HIVE_TOKEN_SECRET (32+ characters). The server refuses to start without it.
HIVE_TOKEN_SECRET=

# Comma-separated browser origins allowed to call this server (CORS + websocket). No trailing slash.
# Local: http://localhost:3000    Production: https://<your SOVA domain>[,https://<other SOVA domain>]
ALLOWED_ORIGINS=

# Interface and port. Local default 127.0.0.1:4200 (the original Chart Hive keeps 4100). Containers: 0.0.0.0:8080.
# DATA_PORT is still accepted as an alias for PORT.
HOST=
PORT=

# Writable data folder (caches, NSE deals history, optional feeds.json). Default: hive-server/data.
QT_DATA_DIR=

# Optional. Upstox Analytics token (read-only, 1 year): live NSE/BSE/MCX prices and candles.
UPSTOX_ANALYTICS_TOKEN=

# Optional. "fly" behind Fly.io's proxy, "xff" behind another reverse proxy that appends X-Forwarded-For,
# empty/"none" when clients connect directly. Only then are proxy headers trusted for per-IP limits.
TRUST_PROXY=
