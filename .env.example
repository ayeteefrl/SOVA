# Chart Hive (/charts) settings for SOVA. Copy the lines you need into .env.local (local) or the
# Vercel project's Environment Variables (production). Never commit real values.
# (SOVA's existing variables such as SESSION_SECRET, SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are not listed here.)

# The owner's SOVA user id (users.id, a UUID). Only this account can manage the access list.
# If this is unset or not a UUID, NOBODY can open /charts, including invited members.
HIVE_OWNER_USER_ID=

# Shared secret for the short-lived data-server tokens. At least 32 characters, and the SAME value
# must be set as HIVE_TOKEN_SECRET on hive-server. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
HIVE_TOKEN_SECRET=

# Public origin of hive-server, no path or trailing slash. The websocket URL is derived from it
# (https -> wss). Local: http://localhost:4200   Production: https://data.<your-domain>
NEXT_PUBLIC_HIVE_DATA_URL=
